@using BlazorPWA.State
@using GameService.Api.Data

<section class="table" data-testid="table-section">
    @foreach (var pair in Pairs)
    {
        <div class="pair" data-testid="table-pair" data-attack-id="@pair.Attack.Id">
            @if (pair.Defence is null)
            {
                <button data-testid="@($"table-attack-{pair.Attack.Id}")"
                        class="card @(SelectedAttackCardId == pair.Attack.Id ? "selected" : "") @(BeatableAttackCardIds.Contains(pair.Attack.Id) ? "beatable" : "") @SuitClass(pair.Attack.Suit)"
                        @onclick="() => OnAttackCardSelected.InvokeAsync(pair.Attack.Id)">
                    <span class="card-rank">@RankToText(pair.Attack.Rank)</span><span class="card-suit">@SuitToText(pair.Attack.Suit)</span>
                </button>
            }
            else
            {
                <div data-testid="@($"table-attack-{pair.Attack.Id}")" class="card @SuitClass(pair.Attack.Suit)">
                    <span class="card-rank">@RankToText(pair.Attack.Rank)</span><span class="card-suit">@SuitToText(pair.Attack.Suit)</span>
                </div>
            }
            <div data-testid="@($"table-defence-{pair.Attack.Id}")" class="card defence @(pair.Defence is null ? "empty" : SuitClass(pair.Defence.Suit))">
                @if (pair.Defence is not null)
                {
                    <span class="card-rank">@RankToText(pair.Defence.Rank)</span><span class="card-suit">@SuitToText(pair.Defence.Suit)</span>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<TablePair> Pairs { get; set; } = Array.Empty<TablePair>();

    [Parameter]
    public string? SelectedAttackCardId { get; set; }

    [Parameter]
    public IReadOnlySet<string> BeatableAttackCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> OnAttackCardSelected { get; set; }

    private static string RankToText(CardRank rank) => rank switch
    {
        CardRank.Two => "2",
        CardRank.Three => "3",
        CardRank.Four => "4",
        CardRank.Five => "5",
        CardRank.Six => "6",
        CardRank.Seven => "7",
        CardRank.Eight => "8",
        CardRank.Nine => "9",
        CardRank.Ten => "10",
        CardRank.Jack => "J",
        CardRank.Queen => "Q",
        CardRank.King => "K",
        CardRank.Ace => "A",
        _ => "?"
    };

    private static string SuitToText(CardSuit suit) => suit switch
    {
        CardSuit.Clubs => "♣",
        CardSuit.Diamonds => "♦",
        CardSuit.Hearts => "♥",
        CardSuit.Spades => "♠",
        _ => "?"
    };

    private static string SuitClass(CardSuit suit) =>
        suit is CardSuit.Hearts or CardSuit.Diamonds ? "suit-red" : "";
}
