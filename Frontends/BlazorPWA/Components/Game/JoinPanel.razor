<section class="card-panel" data-testid="join-panel">
    <h1 data-testid="join-title">Join Game</h1>
    <label class="field">
        <span>Game ID</span>
        <input data-testid="game-id-input"
               placeholder="Enter game id"
               value="@GameId"
               @onchange="OnGameIdInput" />
    </label>
    <label class="field">
        <span>Custom ID</span>
        <input data-testid="custom-id-input"
               placeholder="Enter custom id"
               value="@CustomId"
               @onchange="OnCustomIdInput" />
    </label>
    <button data-testid="connect-button" class="primary" @onclick="OnConnect" disabled="@IsConnecting">Connect</button>
    @if (ShowError && !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="error" data-testid="join-error">@ErrorMessage</div>
    }
</section>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    [Parameter]
    public string CustomId { get; set; } = string.Empty;

    [Parameter]
    public bool IsConnecting { get; set; }

    [Parameter]
    public bool ShowError { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<string> GameIdChanged { get; set; }

    [Parameter]
    public EventCallback<string> CustomIdChanged { get; set; }

    [Parameter]
    public EventCallback OnConnect { get; set; }

    private Task OnGameIdInput(ChangeEventArgs args) =>
        GameIdChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task OnCustomIdInput(ChangeEventArgs args) =>
        CustomIdChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
