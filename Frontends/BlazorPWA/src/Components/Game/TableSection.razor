@using BlazorPWA.State

<section class="table-zone" data-testid="table-section">
    @foreach (var pair in Pairs)
    {
        <div class="pair @(pair.Defence is not null ? "beaten" : "")" data-testid="table-pair" data-attack-id="@pair.Attack.Id">
            @if (pair.Defence is null)
            {
                <CardFace Card="pair.Attack"
                          IsInteractive="true"
                          TestId="@($"table-attack-{pair.Attack.Id}")"
                          StateClasses="@BuildAttackStateClasses(pair.Attack.Id)"
                          VisualState="@GetVisualState(pair.Attack.Id)"
                          OnClick="() => HandleAttackClick(pair.Attack.Id)" />
            }
            else
            {
                <CardFace Card="pair.Attack"
                          TestId="@($"table-attack-{pair.Attack.Id}")" />
            }
            @if (pair.Defence is not null)
            {
                <CardFace Card="pair.Defence"
                          TestId="@($"table-defence-{pair.Attack.Id}")"
                          StateClasses="defence" />
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<TablePair> Pairs { get; set; } = Array.Empty<TablePair>();

    [Parameter]
    public string? SelectedAttackCardId { get; set; }

    [Parameter]
    public IReadOnlySet<string> BeatableAttackCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public bool HasSelectedHandCard { get; set; }

    [Parameter]
    public EventCallback<string> OnAttackCardSelected { get; set; }

    private readonly ShakeState shakeState = new();

    private string BuildAttackStateClasses(string attackId)
    {
        var classes = new List<string>();
        if (SelectedAttackCardId == attackId)
        {
            classes.Add("selected");
        }

        if (BeatableAttackCardIds.Contains(attackId))
        {
            classes.Add("beatable");
        }

        return classes.Count > 0 ? string.Join(" ", classes) : string.Empty;
    }

    private string? GetVisualState(string attackId)
    {
        if (shakeState.ActiveId == attackId)
        {
            return "invalid";
        }

        if (!HasSelectedHandCard || SelectedAttackCardId == attackId)
        {
            return null;
        }

        if (BeatableAttackCardIds.Count == 0)
        {
            return "unbeatable";
        }

        return BeatableAttackCardIds.Contains(attackId) ? null : "unbeatable";
    }

    private async Task HandleAttackClick(string attackId)
    {
        var isBeatable = BeatableAttackCardIds.Contains(attackId);
        if (HasSelectedHandCard && !isBeatable)
        {
            await shakeState.TriggerAsync(attackId, () => InvokeAsync(StateHasChanged));
            return;
        }

        await OnAttackCardSelected.InvokeAsync(attackId);
    }
}
