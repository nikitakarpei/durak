@using BlazorPWA.State
@using GameService.Api.Data

<section class="hand" data-testid="hand-section">
    <div class="hand-cards">
        @foreach (var card in Cards)
        {
            <button data-testid="@($"hand-card-{card.Id}")"
                    class="card @(SelectedCardId == card.Id ? "selected" : "") @(PlayableCardIds.Contains(card.Id) ? "playable" : "") @(BeatableHandCardIds.Contains(card.Id) ? "beatable" : "") @SuitClass(card.Suit)"
                    @onclick="() => OnCardSelected.InvokeAsync(card.Id)">
                <span class="card-rank">@RankToText(card.Rank)</span><span class="card-suit">@SuitToText(card.Suit)</span>
            </button>
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<Card> Cards { get; set; } = Array.Empty<Card>();

    [Parameter]
    public string? SelectedCardId { get; set; }

    [Parameter]
    public IReadOnlySet<string> PlayableCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public IReadOnlySet<string> BeatableHandCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> OnCardSelected { get; set; }

    private static string RankToText(CardRank rank) => rank switch
    {
        CardRank.Two => "2",
        CardRank.Three => "3",
        CardRank.Four => "4",
        CardRank.Five => "5",
        CardRank.Six => "6",
        CardRank.Seven => "7",
        CardRank.Eight => "8",
        CardRank.Nine => "9",
        CardRank.Ten => "10",
        CardRank.Jack => "J",
        CardRank.Queen => "Q",
        CardRank.King => "K",
        CardRank.Ace => "A",
        _ => "?"
    };

    private static string SuitToText(CardSuit suit) => suit switch
    {
        CardSuit.Clubs => "♣",
        CardSuit.Diamonds => "♦",
        CardSuit.Hearts => "♥",
        CardSuit.Spades => "♠",
        _ => "?"
    };

    private static string SuitClass(CardSuit suit) =>
        suit is CardSuit.Hearts or CardSuit.Diamonds ? "suit-red" : "";
}
