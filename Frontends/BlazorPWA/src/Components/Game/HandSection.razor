@using BlazorPWA.State

<section class="hand" data-testid="hand-section">
    <div class="hand-rail">
        <div class="hand-scroll" data-testid="hand-scroll">
            <div class="hand-cards">
                @foreach (var card in Cards)
                {
                    var isSelected = SelectedCardId == card.Id;
                    var isPlayable = PlayableCardIds.Contains(card.Id);
                    var isBeatable = BeatableHandCardIds.Contains(card.Id);
                    <CardFace Card="card"
                              IsInteractive="true"
                              TestId="@($"hand-card-{card.Id}")"
                              StateClasses="@BuildStateClasses(isSelected, isPlayable, isBeatable)"
                              VisualState="@GetVisualState(card.Id, isSelected, isBeatable)"
                              OnClick="() => HandleHandClick(card.Id)" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<Card> Cards { get; set; } = Array.Empty<Card>();

    [Parameter]
    public string? SelectedCardId { get; set; }

    [Parameter]
    public IReadOnlySet<string> PlayableCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public IReadOnlySet<string> BeatableHandCardIds { get; set; } = new HashSet<string>();

    [Parameter]
    public bool HasSelectedAttackCard { get; set; }

    [Parameter]
    public EventCallback<string> OnCardSelected { get; set; }

    private readonly ShakeState shakeState = new();

    private static string BuildStateClasses(bool isSelected, bool isPlayable, bool isBeatable)
    {
        var classes = new List<string>();
        if (isSelected)
        {
            classes.Add("selected");
        }

        if (isPlayable)
        {
            classes.Add("playable");
        }

        if (isBeatable)
        {
            classes.Add("beatable");
        }

        return classes.Count > 0 ? string.Join(" ", classes) : string.Empty;
    }

    private string? GetVisualState(string cardId, bool isSelected, bool isBeatable)
    {
        if (shakeState.ActiveId == cardId)
        {
            return "invalid";
        }

        if (!HasSelectedAttackCard || isSelected)
        {
            return null;
        }

        if (BeatableHandCardIds.Count == 0)
        {
            return "unbeatable";
        }

        return isBeatable ? null : "unbeatable";
    }

    private async Task HandleHandClick(string cardId)
    {
        var isBeatable = BeatableHandCardIds.Contains(cardId);
        if (HasSelectedAttackCard && !isBeatable)
        {
            await shakeState.TriggerAsync(cardId, () => InvokeAsync(StateHasChanged));
            return;
        }

        await OnCardSelected.InvokeAsync(cardId);
    }
}
