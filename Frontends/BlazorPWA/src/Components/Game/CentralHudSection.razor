@using GameService.Api.Data

<section class="central-hud @(Role != CentralHudRole.Neutral ? "central-hud--with-role" : "")" data-testid="central-hud">
    @if (IsTurnActive && TurnTimerDuration.HasValue && TurnTimerDuration.Value > TimeSpan.Zero)
    {
        <svg class="central-hud__timer"
             data-testid="central-hud-timer"
             style="--turn-timer-duration: @($"{TurnTimerDuration.Value.TotalSeconds:0.###}s")"
             viewBox="0 0 100 100"
             preserveAspectRatio="none"
             @key="TurnTimerKey">
            <rect class="central-hud__timer-path" x="2" y="2" width="96" height="96" rx="999" ry="999" pathLength="1"></rect>
        </svg>
    }
    <div class="central-hud__section central-hud__section--trump" data-testid="central-trump">
        @if (TrumpCard is null)
        {
            <span class="central-hud__mini-card central-hud__mini-card--placeholder">?</span>
        }
        else
        {
            <span class="central-hud__mini-card @SuitClass(TrumpCard.Suit)">
                <span class="central-hud__mini-rank">@RankToText(TrumpCard.Rank)</span>
                <span class="central-hud__mini-suit">@SuitToText(TrumpCard.Suit)</span>
            </span>
        }
    </div>
    @if (Role != CentralHudRole.Neutral)
    {
        <div class="central-hud__divider" aria-hidden="true"></div>
        <div class="central-hud__section central-hud__section--role">
            @if (Role == CentralHudRole.Defender)
            {
                <span class="central-hud__role-icon central-hud__role-icon--defender" data-testid="central-role" data-role="defender" aria-hidden="true">🛡️</span>
            }
            else if (Role == CentralHudRole.Attacker)
            {
                <span class="central-hud__role-icon central-hud__role-icon--attacker" data-testid="central-role" data-role="attacker" aria-hidden="true">⚔️</span>
            }
        </div>
    }
    <div class="central-hud__divider" aria-hidden="true"></div>
    <div class="central-hud__section central-hud__section--deck">
        <span class="central-hud__deck-icon" data-testid="central-deck" aria-hidden="true"></span>
        <span class="central-hud__count" data-testid="central-count">@TalonCount</span>
    </div>
</section>

@code {
    [Parameter]
    public RegularCard? TrumpCard { get; set; }

    [Parameter]
    public int TalonCount { get; set; }

    [Parameter]
    public CentralHudRole Role { get; set; }

    [Parameter]
    public bool IsTurnActive { get; set; }

    [Parameter]
    public TimeSpan? TurnTimerDuration { get; set; }

    [Parameter]
    public string TurnTimerKey { get; set; } = "turn-0";

    private static string RankToText(CardRank rank) => rank switch
    {
        CardRank.Two => "2",
        CardRank.Three => "3",
        CardRank.Four => "4",
        CardRank.Five => "5",
        CardRank.Six => "6",
        CardRank.Seven => "7",
        CardRank.Eight => "8",
        CardRank.Nine => "9",
        CardRank.Ten => "10",
        CardRank.Jack => "J",
        CardRank.Queen => "Q",
        CardRank.King => "K",
        CardRank.Ace => "A",
        _ => "?"
    };

    private static string SuitToText(CardSuit suit) => suit switch
    {
        CardSuit.Clubs => "♣",
        CardSuit.Diamonds => "♦",
        CardSuit.Hearts => "♥",
        CardSuit.Spades => "♠",
        _ => "?"
    };

    private static string SuitClass(CardSuit suit) =>
        suit is CardSuit.Hearts or CardSuit.Diamonds ? "suit-red" : "";
}
