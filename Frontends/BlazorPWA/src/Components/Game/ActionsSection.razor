<section class="actions" data-testid="actions-section">
    @if (CanPlayAttack)
    {
        <button data-testid="play-attack-button" @onclick="OnPlayAttack" disabled="@(!IsPlayAttackEnabled)">Play Attack</button>
    }
    @if (CanGiveUpDefence)
    {
        <button data-testid="give-up-defence-button" @onclick="OnGiveUpDefence">Give Up Defence</button>
    }
</section>

@code {
    [Parameter]
    public bool CanPlayAttack { get; set; }

    [Parameter]
    public bool CanGiveUpDefence { get; set; }

    [Parameter]
    public bool IsPlayAttackEnabled { get; set; }

    [Parameter]
    public EventCallback OnPlayAttack { get; set; }

    [Parameter]
    public EventCallback OnGiveUpDefence { get; set; }
}
