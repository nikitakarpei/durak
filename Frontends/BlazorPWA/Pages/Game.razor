@page "/game"
@using BlazorPWA.Services.Connection
@using BlazorPWA.State
@inject IGameConnectionService Connection
@inject GameState State

<main class="game-shell">
    <ErrorToast />
    @if (State.GameId == string.Empty || Connection.Status == ConnectionStatus.Idle)
    {
        <section class="card-panel" data-testid="join-panel">
            <h1 data-testid="join-title">Join Game</h1>
            <label class="field">
                <span>Game ID</span>
                <input data-testid="game-id-input" @bind="gameId" placeholder="Enter game id" />
            </label>
            <label class="field">
                <span>Custom ID</span>
                <input data-testid="custom-id-input" @bind="customId" placeholder="Enter custom id" />
            </label>
            <button data-testid="connect-button" class="primary" @onclick="ConnectAsync" disabled="@isConnecting">Connect</button>
            @if (Connection.Status == ConnectionStatus.Error && !string.IsNullOrWhiteSpace(Connection.ErrorMessage))
            {
                <div class="error" data-testid="join-error">@Connection.ErrorMessage</div>
            }
        </section>
    }
    else
    {
        <section class="match" data-testid="match-panel">
            <section class="opponents" data-testid="opponents-section">
                @foreach (var opponent in GetOpponents())
                {
                    <div class="opponent @(opponent.IsJoined ? "" : "opponent--empty")"
                         data-testid="opponent-seat"
                         data-seat="@opponent.Seat"
                         data-joined="@(opponent.IsJoined ? "true" : "false")"
                         data-card-count="@opponent.CardCount">
                        <div class="opp-avatar">@(opponent.IsJoined ? $"{opponent.Seat + 1}" : "?")</div>
                        <span class="opp-name">@(opponent.IsJoined ? $"Player {opponent.Seat + 1}" : "Not joined")</span>
                        @if (opponent.IsJoined && opponent.CardCount > 0)
                        {
                            <div class="opp-hand" data-testid="opponent-hand" data-seat="@opponent.Seat">
                                @for (var i = 0; i < Math.Min(opponent.CardCount, 8); i++)
                                {
                                    <div class="opp-card-back" data-testid="opponent-card-back" data-seat="@opponent.Seat"></div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <div class="play-area">
            <section class="table" data-testid="table-section">
                @foreach (var pair in State.Table)
                {
                    <div class="pair" data-testid="table-pair" data-attack-id="@pair.Attack.Id">
                        @if (pair.Defence is null)
                        {
                            <button data-testid="@($"table-attack-{pair.Attack.Id}")" class="card @(selectedAttackCardId == pair.Attack.Id ? "selected" : "") @(IsAttackCardBeatable(pair.Attack.Id) ? "beatable" : "") @SuitClass(pair.Attack.Suit)" @onclick="() => SelectAttackCard(pair.Attack.Id)"><span class="card-rank">@RankToText(pair.Attack.Rank)</span><span class="card-suit">@SuitToText(pair.Attack.Suit)</span></button>
                        }
                        else
                        {
                            <div data-testid="@($"table-attack-{pair.Attack.Id}")" class="card @SuitClass(pair.Attack.Suit)"><span class="card-rank">@RankToText(pair.Attack.Rank)</span><span class="card-suit">@SuitToText(pair.Attack.Suit)</span></div>
                        }
                        <div data-testid="@($"table-defence-{pair.Attack.Id}")" class="card defence @(pair.Defence is null ? "empty" : SuitClass(pair.Defence.Suit))">@if (pair.Defence is not null) {<span class="card-rank">@RankToText(pair.Defence.Rank)</span><span class="card-suit">@SuitToText(pair.Defence.Suit)</span>}</div>
                    </div>
                }
            </section>

            <div class="deck-area" data-testid="deck-area">
                <div class="deck-pile @(State.TalonCount > 0 ? "deck-pile--stacked" : "")">
                    @if (State.TrumpCard is not null)
                    {
                        <div data-testid="trump-card" class="card trump-face @(State.TalonCount > 0 ? "trump-face--rotated" : "") @SuitClass(State.TrumpCard.Suit)"><span class="card-rank">@RankToText(State.TrumpCard.Rank)</span><span class="card-suit">@SuitToText(State.TrumpCard.Suit)</span></div>
                    }
                    @if (State.TalonCount > 0)
                    {
                        <div data-testid="deck-back-card" class="deck-back-card">
                            <span data-testid="talon-count" data-count="@State.TalonCount" class="deck-count">@State.TalonCount</span>
                        </div>
                    }
                </div>
            </div>
            </div>

            <section class="hand" data-testid="hand-section">
                <div class="hand-cards">
                    @foreach (var card in State.YourHand)
                    {
                        <button data-testid="@($"hand-card-{card.Id}")" class="card @(selectedCardId == card.Id ? "selected" : "") @(IsCardPlayable(card.Id) ? "playable" : "") @(IsHandCardBeatable(card.Id) ? "beatable" : "") @SuitClass(card.Suit)" @onclick="() => SelectCard(card.Id)"><span class="card-rank">@RankToText(card.Rank)</span><span class="card-suit">@SuitToText(card.Suit)</span></button>
                    }
                </div>
            </section>

            <section class="actions" data-testid="actions-section">
                @if (State.YourPossibleMoves.Any(m => m.Type == PossibleMoveType.PlayAttackCard))
                {
                    <button @onclick="PlayAttackAsync" disabled="@string.IsNullOrWhiteSpace(selectedCardId)">Play Attack</button>
                }
                @if (State.YourPossibleMoves.Any(m => m.Type == PossibleMoveType.BeatAttackCard))
                {
                    <button @onclick="BeatAttackAsync" disabled="@(string.IsNullOrWhiteSpace(selectedCardId) || string.IsNullOrWhiteSpace(selectedAttackCardId))">Beat Attack</button>
                }
                @if (State.YourPossibleMoves.Any(m => m.Type == PossibleMoveType.GiveUpDefence))
                {
                    <button @onclick="GiveUpAsync">Give Up Defence</button>
                }
            </section>
        </section>
    }
</main>

@code {
    private string gameId = string.Empty;
    private string customId = string.Empty;
    private bool isConnecting;
    private string? selectedCardId;
    private string? selectedAttackCardId;
    private bool _gameIdLogged;

    protected override void OnInitialized()
    {
        Connection.StateChanged += OnConnectionStateChanged;
    }

    private void OnConnectionStateChanged()
    {
        if (!_gameIdLogged && !string.IsNullOrEmpty(State.GameId))
        {
            Console.WriteLine($"[Game] id={State.GameId}");
            _gameIdLogged = true;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ConnectAsync()
    {
        if (string.IsNullOrWhiteSpace(gameId))
        {
            return;
        }

        isConnecting = true;
        await Connection.ConnectAsync(gameId.Trim(), customId.Trim(), CancellationToken.None);
        isConnecting = false;
    }

    private IEnumerable<OpponentSeatView> GetOpponents()
    {
        var localSeat = State.LocalPlayerId is not null &&
                        State.Players.TryGetValue(State.LocalPlayerId, out var localPlayer)
            ? localPlayer.Seat
            : (int?)null;

        var joinedBySeat = State.Players.Values
            .Where(p => State.LocalPlayerId is null || p.PlayerId != State.LocalPlayerId)
            .GroupBy(p => p.Seat)
            .ToDictionary(g => g.Key, g => g.First());

        var highestKnownSeat = joinedBySeat.Keys.DefaultIfEmpty(-1).Max();
        if (localSeat.HasValue)
        {
            highestKnownSeat = Math.Max(highestKnownSeat, localSeat.Value);
        }

        var seatCountFromGame = State.TotalPlayerSeats ?? 0;
        var totalSeats = Math.Max(seatCountFromGame, highestKnownSeat + 1);
        if (totalSeats <= 0)
        {
            return Enumerable.Empty<OpponentSeatView>();
        }

        var visibleSeats = Enumerable.Range(0, totalSeats)
            .Where(seat => localSeat is null || seat != localSeat.Value)
            .ToList();

        if (localSeat is null && State.LocalPlayerId is not null && seatCountFromGame > 0 && visibleSeats.Count > 0)
        {
            var reservedLocalSeat = visibleSeats.FirstOrDefault(seat => !joinedBySeat.ContainsKey(seat));
            if (joinedBySeat.ContainsKey(reservedLocalSeat))
            {
                reservedLocalSeat = visibleSeats[^1];
            }

            visibleSeats.Remove(reservedLocalSeat);
        }

        return visibleSeats.Select(seat =>
            {
                if (joinedBySeat.TryGetValue(seat, out var player))
                {
                    return new OpponentSeatView(seat, player.PlayerId, player.CardCount, true);
                }

                return new OpponentSeatView(seat, null, 0, false);
            });
    }

    private string RenderCardLabel(GameService.Api.Data.RegularCard? card)
    {
        if (card is null)
        {
            return "-";
        }

        return RenderCardLabel(new Card(card.Id, card.Suit, card.Rank));
    }

    private string RenderCardLabel(Card card)
    {
        return $"{RankToText(card.Rank)}{SuitToText(card.Suit)}";
    }

    private static string RankToText(GameService.Api.Data.CardRank rank) => rank switch
    {
        GameService.Api.Data.CardRank.Two => "2",
        GameService.Api.Data.CardRank.Three => "3",
        GameService.Api.Data.CardRank.Four => "4",
        GameService.Api.Data.CardRank.Five => "5",
        GameService.Api.Data.CardRank.Six => "6",
        GameService.Api.Data.CardRank.Seven => "7",
        GameService.Api.Data.CardRank.Eight => "8",
        GameService.Api.Data.CardRank.Nine => "9",
        GameService.Api.Data.CardRank.Ten => "10",
        GameService.Api.Data.CardRank.Jack => "J",
        GameService.Api.Data.CardRank.Queen => "Q",
        GameService.Api.Data.CardRank.King => "K",
        GameService.Api.Data.CardRank.Ace => "A",
        _ => "?"
    };

    private static string SuitToText(GameService.Api.Data.CardSuit suit) => suit switch
    {
        GameService.Api.Data.CardSuit.Clubs => "♣",
        GameService.Api.Data.CardSuit.Diamonds => "♦",
        GameService.Api.Data.CardSuit.Hearts => "♥",
        GameService.Api.Data.CardSuit.Spades => "♠",
        _ => "?"
    };

    private static string SuitClass(GameService.Api.Data.CardSuit suit) =>
        suit is GameService.Api.Data.CardSuit.Hearts or GameService.Api.Data.CardSuit.Diamonds
            ? "suit-red"
            : "";

    private bool IsCardPlayable(string cardId) =>
        State.YourPossibleMoves.Any(m => m.YourCardId == cardId);

    private bool IsAttackCardBeatable(string attackCardId) =>
        !string.IsNullOrWhiteSpace(selectedCardId) &&
        State.YourPossibleMoves.Any(m =>
            m.Type == PossibleMoveType.BeatAttackCard &&
            m.YourCardId == selectedCardId &&
            m.TargetCardId == attackCardId);

    private bool IsHandCardBeatable(string handCardId) =>
        !string.IsNullOrWhiteSpace(selectedAttackCardId) &&
        State.YourPossibleMoves.Any(m =>
            m.Type == PossibleMoveType.BeatAttackCard &&
            m.TargetCardId == selectedAttackCardId &&
            m.YourCardId == handCardId);

    private void SelectCard(string cardId)
    {
        selectedCardId = selectedCardId == cardId ? null : cardId;
    }

    private void SelectAttackCard(string cardId)
    {
        selectedAttackCardId = selectedAttackCardId == cardId ? null : cardId;
    }

    private Task PlayAttackAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedCardId) || Connection.AccessToken is null)
        {
            return Task.CompletedTask;
        }

        return Connection.PlayAttackCardAsync(Connection.AccessToken, selectedCardId, CancellationToken.None);
    }

    private Task BeatAttackAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedCardId) || string.IsNullOrWhiteSpace(selectedAttackCardId) || Connection.AccessToken is null)
        {
            return Task.CompletedTask;
        }

        return Connection.BeatAttackCardAsync(Connection.AccessToken, selectedAttackCardId, selectedCardId, CancellationToken.None);
    }

    private Task GiveUpAsync()
    {
        if (Connection.AccessToken is null)
        {
            return Task.CompletedTask;
        }

        return Connection.GiveUpDefenceAsync(Connection.AccessToken, CancellationToken.None);
    }

    private sealed record OpponentSeatView(int Seat, string? PlayerId, int CardCount, bool IsJoined);
}
