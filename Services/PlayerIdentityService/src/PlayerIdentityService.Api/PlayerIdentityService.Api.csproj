<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Grpc.Tools" Version="2.72.0" />
        <PackageReference Include="Google.Protobuf" Version="3.31.0" />
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="$(SolutionDir)Protos\player_identity_service\**\*.proto" GrpcServices="None" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PlayerIdentityService.Application\PlayerIdentityService.Application.csproj" />
        <ProjectReference Include="..\PlayerIdentityService.Domain\PlayerIdentityService.Domain.csproj" />
        <ProjectReference Include="$(SolutionDir)\Libraries\LibRpc\src\LibRpc.Core\LibRpc.Core.csproj" />
    </ItemGroup>
</Project>
